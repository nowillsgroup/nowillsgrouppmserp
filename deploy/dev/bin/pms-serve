#!/usr/bin/env bash
# Nowills PMS dev HTTP server (0.0.0.0:$PORT, default 8000).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUN="$DIR/node_modules/.bin-local/bun"
if [ ! -x "$BUN" ]; then
  echo "Runtime not installed — run deploy/dev/setup.sh first" >&2
  exit 1
fi
# phpext side-module discovery scans node_modules upwards from cwd.
cd "$DIR"
exec "$BUN" "$DIR/serve.mjs" "$@"
