<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://nowills.com/pms/iptv"
        version="1.0.0"
        viewmodes="maximized">
  <name>Nowills PMS IPTV</name>
  <description>Hotel guest welcome and IPTV portal for Nowills PMS.</description>
  <content src="www/index.html" />
  <icon src="icon.png" />
  <access origin="*" subdomains="true" />
  <tizen:application id="NwPmsTV001.NowillsPmsTV" package="NwPmsTV001" required_version="2.3" />
  <tizen:profile name="tv" />
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable" />
  <feature name="http://tizen.org/feature/network.internet" />
  <tizen:privilege name="http://tizen.org/privilege/internet" />
</widget>
